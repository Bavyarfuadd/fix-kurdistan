# Copy to .env and fill in
ANTHROPIC_API_KEY=sk-ant-...
# Any vision-capable Claude model
ANTHROPIC_MODEL=claude-sonnet-4-5
# Password for the admin dashboard (sent as x-admin-key header)
ADMIN_KEY=change-me
# Optional: enables Google Roadmap/Satellite/Hybrid in the map layer switcher.
# Enable "Maps JavaScript API" in Google Cloud and restrict the key by HTTP referrer.
GOOGLE_MAPS_API_KEY=
PORT=3000
